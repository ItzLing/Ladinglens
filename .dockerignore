# The dataset and its scorer are organizer-only and must never enter an image.
data/*
!data/loader.py

# Run artifacts and caches -- regenerated, and stale copies would mislead.
results/
ocr_cache/
__pycache__/
*.pyc

# The web UI ships (app/main.py serves it at /), but its tooling and docs do not.
web/build_report.py
web/*.md
web/__pycache__/

scripts/
tests/
# worked examples for the team, never part of the image
reference/
.git/
.env
.env.*
