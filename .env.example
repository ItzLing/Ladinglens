# Copy to .env and fill in before running the pipeline.
#
# Any OpenAI-compatible endpoint works -- switching providers is a change here,
# not a code change. Pick one block below and leave the rest commented.

# --- Ollama: local, no quota, no key. Best for iterating on prompts.
# Install from https://ollama.com, then: ollama pull llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=llama3.1:8b

# --- Groq: hosted, free tier, very fast. Key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- Gemini: hosted, free tier. Key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=gemini-3.6-flash

# Output budget per call. Reasoning models spend "thinking" tokens out of this
# same budget, so keep real headroom -- too low and replies truncate mid-JSON.
LLM_MAX_TOKENS=4096

# Local dataset folder (default) or the hackathon's Docker dataset server URL,
# e.g. http://localhost:8080
INBOX_SOURCE=data/data_v2
