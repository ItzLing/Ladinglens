# Copy to .env and fill in before running the pipeline.
#
# Any OpenAI-compatible endpoint works -- switching providers is a change here,
# not a code change. Uncomment one block and comment the rest.
#
# After editing .env, restart uvicorn or `touch app/main.py`: --reload watches
# .py files, not .env, so a running server keeps the old settings and a switch
# looks like a total failure.

# --- Gemini 3.6-flash: produced the 0.6442 baseline (2026-09-21).
# Reasoning model: spends ~800-1000 thinking tokens per call out of
# LLM_MAX_TOKENS. That budget needs real headroom or replies truncate mid-JSON
# and get logged as processing_error -- which looks like a document problem but
# isn't. Key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_MAX_TOKENS=16384

# --- Gemini 3.1-flash-lite: non-reasoning, ~10 completion tokens per call, so
# it is safe at a much smaller budget. Scored lower than 3.6-flash. Gemini's
# free tier is 500 requests/day PER MODEL, so switching also buys fresh quota.
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_MAX_TOKENS=2048

# --- Ollama: local, no quota, no key. Needs `ollama pull <model>` first.
# The only uncapped option -- use it to iterate on prompts for free.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=llama3.1:8b

# --- Groq: free-tier caps are too small for a 520-email run (~724 requests).
# gpt-oss-120b = 200k tokens/day; gpt-oss-20b and qwen/qwen3.8-27b = 8k
# tokens/min and 1000 requests/day. The llama-3.x chat models are not offered.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b

# Parallel in-flight calls. Kept modest so a free-tier per-minute limit doesn't
# trigger constant backoff -- raise if the provider allows it.
LLM_CONCURRENCY=2

# Scanned PDFs and image files are read by Tesseract OCR first (needs the Tesseract
# program installed, see README). A field whose OCR confidence (0-100, the weakest
# word in it) is below this goes to a vision LLM looking at the page image instead.
# Not yet calibrated against real scans -- tune it once Tesseract is running.
# OCR_MIN_CONFIDENCE=80
# Path to tesseract.exe if it is not on PATH (the default Windows install folder is
# found automatically):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Model for that vision step. Needs image support; defaults to LLM_MODEL. Set it when
# the main model is text-only, e.g. a local Ollama model:
#   LLM_VISION_MODEL=llama3.2-vision
# LLM_VISION_MODEL=

# Folder holding inbox/ and attachments/ (default: data), or the hackathon's Docker
# dataset server URL, e.g. http://localhost:8080
INBOX_SOURCE=data
