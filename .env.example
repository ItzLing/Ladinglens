# Copy to .env and fill in before running the pipeline.
# Get a free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Output budget per call. Gemini 3.x spends "thinking" tokens out of this same
# budget (~800-980 observed on one extract call), so keep real headroom here --
# too low and replies get truncated mid-JSON.
GEMINI_MAX_TOKENS=4096

# Local dataset folder (default) or the hackathon's Docker dataset server URL,
# e.g. http://localhost:8080
INBOX_SOURCE=data
